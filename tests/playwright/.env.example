# Copy to tests/playwright/.env (gitignored).
#
# Base URL of a running store. Must be HTTPS: MONEI components load in
# cross-origin iframes and 3D Secure returns to an https origin.
MONEI_E2E_BASE_URL=https://magento.monei-dev-tunnel.com

# A simple product URL path with no required options, used to fill the cart.
MONEI_E2E_PRODUCT_PATH=/joust-duffle-bag.html
